{
  "manifest_version": 3,
  "name": "Factcheck Panel",
  "version": "1.0",
  "description": "Factcheckt de actieve tab via Mistral AI in een vaste zijbalk",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.mistral.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "Open Factcheck Panel"
  }
}