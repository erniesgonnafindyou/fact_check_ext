{
  "manifest_version": 3,
  "name": "Factcheck Panel",
  "version": "1.0",
  "description": "Factcheckt de actieve tab via Mistral AI in een vaste zijbalk",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.mistral.ai/*",
    "https://api.tavily.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "16": "icons/icon-badge.png",
    "48": "icons/icon-badge.png",
    "128": "icons/icon-badge.png"
  },
  "action": {
    "default_title": "Open Factcheck Panel",
    "default_icon": {
        "16": "icons/icon-badge.png",
        "48": "icons/icon-badge.png",
        "128": "icons/icon-badge.png"
    }
  }
}